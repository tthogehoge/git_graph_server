{
  "name": "git-graph-merge-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bundles CodeMirror 6 for the git_graph_server merge editor (build output: git_graph/static/vendor/merge_editor.js)",
  "scripts": {
    "build": "npm run build:merge && npm run build:text",
    "build:merge": "esbuild src/merge_entry.js --bundle --minify --format=iife --charset=ascii --target=es2019 --legal-comments=none --global-name=GGMerge --outfile=../../git_graph/static/vendor/merge_editor.js",
    "build:text": "esbuild src/text_entry.js --bundle --minify --format=iife --charset=ascii --target=es2019 --legal-comments=none --global-name=GGText --outfile=../../git_graph/static/vendor/text_editor.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.10.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@replit/codemirror-vim": "^6.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0"
  }
}
